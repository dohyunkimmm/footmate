
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "footmate",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 0.1
    },
    "traces": {
      "enabled": false
    },
    "issues": {
      "enabled": true
    }
  },

"ratelimits": [
  {
    "name": "AI_RATE_LIMITER",
    "namespace_id": "20261025",
    "simple": {
      "limit": 10,
      "period": 60
    }
  }
],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": [
  "/",
  "/api/*",
  "/demo",
  "/beta",
  "/beta/operator",
  "/prototype",
  "/app",
  "/app.html",
  "/demo.html",
  "/next",
  "/next.html"
]
  }
}