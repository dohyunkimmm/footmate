{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "ignoreCommand": "node scripts/vercel-ignore-build.cjs",
  "cleanUrls": false,
  "trailingSlash": false,
  "functions": {
    "api/ai-match-assistant.js": {"maxDuration": 10}
  },
  "rewrites": [
    {"source":"/app","destination":"/app.html"},
    {"source":"/beta/operator","destination":"/beta-operator.html"},
    {"source":"/beta","destination":"/beta.html"},
    {"source":"/demo","destination":"/app.html"},
    {"source":"/demo.html","destination":"/app.html"},
    {"source":"/next","destination":"/app.html"},
    {"source":"/next.html","destination":"/app.html"}
  ]
}
