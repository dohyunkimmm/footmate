{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "ignoreCommand": "node scripts/vercel-ignore-build.cjs",
  "cleanUrls": false,
  "trailingSlash": false,
  "functions": {
    "api/ai-match-assistant.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/demo",
      "destination": "/beta.html"
    },
    {
      "source": "/beta/operator",
      "destination": "/beta-operator.html"
    },
    {
      "source": "/beta",
      "destination": "/beta.html"
    },
    {
      "source": "/prototype",
      "destination": "/app.html"
    }
  ],
  "redirects": [
    {
      "source": "/app",
      "destination": "/demo?entry=footmate",
      "permanent": false
    },
    {
      "source": "/app.html",
      "destination": "/demo?entry=footmate",
      "permanent": false
    },
    {
      "source": "/demo.html",
      "destination": "/demo?entry=footmate",
      "permanent": false
    },
    {
      "source": "/next",
      "destination": "/demo?entry=footmate",
      "permanent": false
    },
    {
      "source": "/next.html",
      "destination": "/demo?entry=footmate",
      "permanent": false
    }
  ]
}
